<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students Data</title>
</head>
<body>
    <h1>Students Data....</h1>

    <table border="2px solid black"><tr>
        <th>name</th>
        <th>Link</th>
        </tr>
        <% result.forEach(Students=>{ %>
            <tr>
          <td><%= Students.name %></td>  
          <td><%= Students.link %></td>  
        </tr>
       <% }) %>

    </table>
</body>
</html>